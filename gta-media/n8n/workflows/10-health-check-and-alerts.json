{
  "name": "VicePulse 10 - Health check and alerts",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "5 * * * *"
            }
          ]
        }
      },
      "id": "110bd507-6cdb-5ffc-b4fb-f5c80e0f45d3",
      "name": "Hourly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://worker:8088/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"args\": [\"health\"]}",
        "options": {
          "timeout": 3600000
        }
      },
      "id": "6e4cc352-d4b8-564c-8b20-854c82530a4c",
      "name": "Health check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_WORKER_CREDENTIAL_ID",
          "name": "VicePulse worker"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "09bdcf8b-8294-544b-808b-4785aed7ea32",
              "leftValue": "={{ $json.healthy }}",
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "3549fd42-383b-57c2-b78a-2e07d7223022",
      "name": "Any alerts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $vars.TELEGRAM_REVIEW_CHAT_ID }}",
        "text": "=VicePulse health:\n{{ $json.alerts.join('\\n') }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "49023414-9f14-5164-a9fb-b5e5b88ad55c",
      "name": "Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        780,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_TELEGRAM_CREDENTIAL_ID",
          "name": "VicePulse Telegram"
        }
      }
    }
  ],
  "connections": {
    "Hourly": {
      "main": [
        [
          {
            "node": "Health check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Health check": {
      "main": [
        [
          {
            "node": "Any alerts?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any alerts?": {
      "main": [
        [
          {
            "node": "Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC",
    "saveManualExecutions": true
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false,
    "note": "Hourly: failed or blocked posts, expiring licences, short days, waiting approvals."
  },
  "tags": [
    {
      "name": "vicepulse"
    }
  ]
}
