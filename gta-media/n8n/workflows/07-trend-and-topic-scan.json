              "value": "25"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "options": {}
      },
      "id": "b6ed36b3-254f-5554-80f2-a70210af27c3",
      "name": "YouTube trending gaming (US)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ],
      "credentials": {
        "httpQueryAuth": {
          "id": "REPLACE_WITH_YOUTUBE_CREDENTIAL_ID",
          "name": "YouTube Data API key"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/youtube/v3/videos",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "part",
              "value": "snippet"
            },
            {
              "name": "chart",
              "value": "mostPopular"
            },
            {
              "name": "videoCategoryId",
              "value": "20"
            },
            {
              "name": "regionCode",
              "value": "BR"
            },
            {
              "name": "maxResults",
              "value": "25"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "options": {}
      },
      "id": "58257141-c38f-506a-9e8c-3f48360cf5cd",
      "name": "YouTube trending gaming (BR)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        300
      ],
      "credentials": {
        "httpQueryAuth": {
          "id": "REPLACE_WITH_YOUTUBE_CREDENTIAL_ID",
          "name": "YouTube Data API key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  if (j.title && j.link) out.push({ topic: j.title, source: 'rockstar_newswire', score: 5, language: 'en' });\n  for (const v of (j.items || [])) {\n    const t = v.snippet.title;\n    if (!/gta|grand theft auto/i.test(t)) continue;\n    const br = (v.snippet.defaultAudioLanguage || '').startsWith('pt');\n    out.push({ topic: t, source: 'youtube_trending_gaming', score: 3, language: br ? 'pt-BR' : 'en' });\n  }\n}\nreturn [{ json: { args: ['topics-add', '--json', JSON.stringify(out)] } }];"
      },
      "id": "a98bf0cc-76cc-5ce9-9e35-6c4516a46b75",
      "name": "To topics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://worker:8088/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ args: $json.args }) }}",
        "options": {
          "timeout": 3600000
        }
      },
      "id": "3fbbd4c1-2d42-5376-8c35-6cc217f98f8e",
      "name": "Store topics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_WORKER_CREDENTIAL_ID",
          "name": "VicePulse worker"
        }
      }
    },
    {
      "parameters": {
        "numberInputs": 3
      },
      "id": "053c8b25-f67f-5c84-acae-c44880e9d332",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1560,
        300
      ]
    }
  ],
