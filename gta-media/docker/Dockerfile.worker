# VicePulse worker: Python pipeline + FFmpeg, serving the CLI to n8n over the private docker network.
FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
COPY db ./db
COPY config ./config
# Optional local speech-to-text for subtitles (free, CPU). Build with VICEPULSE_BUILD_WHISPER=1.
ARG WHISPER=0
RUN if [ "$WHISPER" = "1" ]; then pip install --no-cache-dir ".[whisper]"; else pip install --no-cache-dir .; fi

RUN useradd --create-home vicepulse && mkdir -p /data && chown vicepulse /data
USER vicepulse
ENV VICEPULSE_DATA_DIR=/data \
    VICEPULSE_HOME=/app \
    WHISPER_CACHE_DIR=/data/models/whisper \
    HF_HOME=/data/models/hf
EXPOSE 8088
CMD ["vicepulse", "serve"]
