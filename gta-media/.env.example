# VicePulse configuration. Copy to .env and fill in locally. Never commit .env.
# Every value below is a placeholder; none of these is a real credential.

# --- Core ---------------------------------------------------------------
DATABASE_URL=postgresql://vicepulse:change-me@localhost:5432/vicepulse
VICEPULSE_DATA_DIR=./data                # footage, frames, renders (object storage mount in production)
VICEPULSE_GAME=gta5                      # gta5 for testing, gta6 at launch
VICEPULSE_CHANNELS_FILE=./config/channels.json
VICEPULSE_GAMES_FILE=./config/games.json

# --- Safety switches (defaults are the safe values) ---------------------
# LLM_MODE=mock uses the offline mock; LLM_MODE=anthropic makes real, billed Claude API calls.
LLM_MODE=mock
# Publishing stays a dry run unless this is exactly 1. Even then, each platform client
# also needs its own token below. Keep 0 until the owner approves going live.
VICEPULSE_ALLOW_LIVE_PUBLISH=0
# Human approval is required before anything is scheduled. Set per platform later (go/no-go in PLAN.md).
VICEPULSE_REQUIRE_APPROVAL=1
# Channels are treated as monetised, so every licence must allow monetisation. 0 relaxes that check.
VICEPULSE_MONETISED=1

# --- Claude API (only used when LLM_MODE=anthropic) ---------------------
ANTHROPIC_API_KEY=
VICEPULSE_MODEL_MAIN=claude-opus-5-5
VICEPULSE_MODEL_TRIAGE=claude-haiku-5-5
# Server-side refusal fallback for the Opus calls (set to 0 to turn off).
VICEPULSE_LLM_FALLBACKS=1

# --- Transcription --------------------------------------------------------
# none | whisper  (whisper needs `pip install .[whisper]`, or the worker built with VICEPULSE_BUILD_WHISPER=1; runs locally, free)
VICEPULSE_TRANSCRIBER=none
VICEPULSE_BUILD_WHISPER=0
# tiny | base | small (small is more accurate, slower on CPU). The model downloads once into the data volume.
WHISPER_MODEL=base
# auto: subtitles are the clip's real speech when Whisper is on, else the commentary script; or transcript | script
VICEPULSE_CAPTIONS=auto

# --- Voice ----------------------------------------------------------------
# own: look for <VOICE_DIR>/<clip_id>.wav recorded by the owner; none: captions only.
VICEPULSE_VOICE_MODE=own
VICEPULSE_VOICE_DIR=./data/voice

# --- Worker HTTP API (n8n calls this inside the docker network) -----------
VICEPULSE_WORKER_TOKEN=change-me-long-random-string
VICEPULSE_WORKER_PORT=8088

# --- Public media URL (Instagram and TikTok PULL_FROM_URL fetch from here) --
VICEPULSE_PUBLIC_MEDIA_BASE_URL=https://media.example.invalid/renders

# --- Platform credentials, one set per channel (EN / BR) ------------------
# YouTube (OAuth refresh tokens from the owner's own Google account)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN_EN=
YOUTUBE_REFRESH_TOKEN_BR=
# Instagram (Instagram API with Instagram Login, professional accounts)
INSTAGRAM_USER_ID_EN=
INSTAGRAM_ACCESS_TOKEN_EN=
INSTAGRAM_USER_ID_BR=
INSTAGRAM_ACCESS_TOKEN_BR=
# TikTok (Content Posting API, user access tokens with video.publish)
TIKTOK_ACCESS_TOKEN_EN=
TIKTOK_ACCESS_TOKEN_BR=

# --- Creator discovery (read-only, official APIs, free) -------------------------
# YouTube Data API v3 key (Google Cloud project -> APIs & Services -> Credentials -> API key;
# restrict it to the YouTube Data API v3). Costs quota units, not money.
YOUTUBE_DATA_API_KEY=
YOUTUBE_DAILY_QUOTA_BUDGET=8000
# Twitch application (dev.twitch.tv -> Your Console -> Register Your Application), client-credentials only.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Hands-free clip production (vicepulse autoclip) ---------------------------
# Wikimedia requires contact details in automated requests: an email address or URL where you can be reached.
WIKIMEDIA_CONTACT=
# Set to 1 to declare, once, that every file you put in <data>/incoming/own is your own recording.
VICEPULSE_OWN_FOLDER_DECLARED=0

# --- Alerts -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_REVIEW_CHAT_ID=

# --- docker-compose only ------------------------------------------------------
POSTGRES_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me-long-random-string
